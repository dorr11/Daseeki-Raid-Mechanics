core.lua
theme.lua
media.lua
soundpacks.lua

# ── 2.0 engine core (wave 1) ───────────────────────────────────────────────────
# Load order is a dependency chain: heap -> telemetry -> scheduler -> timers ->
# encounter API -> lifecycle -> boot. Nothing below reaches upward at load time.
core_heap.lua
core_telemetry.lua
core_sched.lua
core_timers.lua
core_api.lua
core_lifecycle.lua
core_boot.lua

# ── 2.0 addon channel + recovery (wave 3) ──────────────────────────────────────
# Loads AFTER core_boot: it registers on the engine dispatch seam and owns the pull
# and break timers core_boot used to shim. core_boot:InitEngine() calls Sync:Boot()
# at LOGIN, so the backward reference is resolved at call time, not at load time.
core_sync.lua

# ── 2.0 presentation + engine services (wave 2) ────────────────────────────────
# Services first, then presentation, then the public contract. svc_era installs the
# role/class resolvers core_api's ship-off defaults call, so it precedes anything
# that can evaluate a row. Every file here hangs off the wave-1 dispatch seam and
# is loaded AFTER it.
svc_era.lua
svc_scan.lua
ui_bars.lua
ui_warnings.lua
public_api.lua

alerts.lua
dbm_bridge.lua
modules.lua
mod_loatheb_healers.lua
mod_fourhorsemen_rotation.lua
mod_fourhorsemen_tracker.lua
mod_gothik_waves.lua
mod_razuvious_understudy.lua
thaddius.lua

# ── 2.0 encounter data (wave 4) ────────────────────────────────────────────────
# Declarative encounter definitions in the core_api grammar. Loaded AFTER the
# special modules so the `legacy = { raidId, bossId }` seam in each definition sits
# next to the modules it attaches to; the registry itself only needs core_api.
enc_naxxramas.lua
enc_aq20.lua
enc_aq40.lua

soundpicker.lua
options.lua
slash.lua

# ── RETIRED in 2.0 (do not re-add) ─────────────────────────────────────────────
# engine.lua      DELETED — replaced by core_sched/core_timers/core_lifecycle/core_api.
# encounters.lua  DELETED — replaced by the declarative registry in core_api.lua.
#
# ── PARKED, still on disk, deliberately NOT loaded ─────────────────────────────
# data_bwl.lua
#   The 1.x flat mechanic model. W4 regenerates all eight zones in the new
#   declarative grammar; this stays on disk until W4b purely as cross-check input
#   for the spell IDs already verified against Drew's combat logs. Re-adding it to
#   the load list is refused at runtime by Addon:RegisterRaid (core_boot.lua) and
#   is a harness failure (GATE RETIRE).
#
# data_naxxramas.lua  DELETED in W4d — enc_naxxramas.lua replaces it. Its values
#   were diffed against the spec first; every disagreement is in the wave report and
#   the CHANGELOG, and the spec won each one.
# data_aq40.lua       DELETED in W4c — enc_aq40.lua replaces it, on the same terms.
#   AQ20 had no 1.x predecessor at all; enc_aq20.lua is new ground.
