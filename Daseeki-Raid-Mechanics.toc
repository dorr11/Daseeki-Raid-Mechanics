# ── 2.0 engine core (wave 1) ───────────────────────────────────────────────────
# Load order is a dependency chain: heap -> telemetry -> scheduler -> timers ->
# encounter API -> lifecycle -> diagnostics -> boot. Nothing below reaches upward
# at load time.
#
# core_diag.lua (W5) holds the owner's measuring instruments — the SavedVariables
# combat-log capture, the auto-debug policy, the Debug-Only indicator and the
# kill-statistics text. It resolves Addon.Sched and Addon.Lifecycle at LOAD, so it
# must follow both; core_boot.lua calls Addon.DLog and Addon:UpdateAutoDebug, so it
# must follow this.
core_heap.lua
core_telemetry.lua
core_sched.lua
core_timers.lua
core_api.lua
core_lifecycle.lua
core_diag.lua
core_boot.lua

# ── 2.0 addon channel + recovery (wave 3) ──────────────────────────────────────
# Loads AFTER core_boot: it registers on the engine dispatch seam and owns the pull
# and break timers core_boot used to shim. core_boot:InitEngine() calls Sync:Boot()
# at LOGIN, so the backward reference is resolved at call time, not at load time.
core_sync.lua

# ── 2.0 presentation + engine services (wave 2) ────────────────────────────────
# Services first, then presentation, then the public contract. svc_era installs the
# role/class resolvers core_api's ship-off defaults call, so it precedes anything
# that can evaluate a row. Every file here hangs off the wave-1 dispatch seam and
# is loaded AFTER it.
svc_era.lua
svc_scan.lua
# ui_anchors.lua is the PLACEMENT MODEL (bucket routing + the anchor resolver). Both
# surfaces below route every row through it, and core_api's options projection asks it
# to describe a row's severity, so it is defined before any of its consumers. It needs
# only theme.lua (HudAnchor) and core.lua (SetMechanicPos), both far above.
ui_anchors.lua
ui_bars.lua
ui_warnings.lua
public_api.lua
# ui_testing.lua is the TESTING SUITE (per-row play/sound, per-boss rehearsal, layout
# mode, compressed playback, /drm validate). It drives the two surfaces above and the
# placement model through their REAL paths and owns no rendering of its own, so it must
# follow all three. It reaches modules.lua and the encounter registry at CALL time only.
ui_testing.lua

alerts.lua
dbm_bridge.lua
modules.lua
mod_loatheb_healers.lua
mod_fourhorsemen_rotation.lua
mod_fourhorsemen_tracker.lua
mod_gothik_waves.lua
mod_razuvious_understudy.lua
thaddius.lua

# ── 2.0 encounter data (wave 4) ────────────────────────────────────────────────
# Declarative encounter definitions in the core_api grammar. Loaded AFTER the
# special modules so the `legacy = { raidId, bossId }` seam in each definition sits
# next to the modules it attaches to; the registry itself only needs core_api.
enc_naxxramas.lua
enc_aq20.lua
enc_aq40.lua
enc_bwl.lua
enc_zg.lua
enc_moltencore.lua
enc_onyxia.lua
